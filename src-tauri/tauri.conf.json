{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "Copyright (c) 2026 Albert Xu. Based on LRCGET, Copyright (c) 2023 tranxuanthang, MIT License.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/sing-along.desktop",
        "files": {
          "/usr/share/metainfo/sing-along.metainfo.xml": "../packaging/linux/sing-along.metainfo.xml",
          "/usr/share/man/man1/sing-along.1": "../packaging/linux/sing-along.1",
          "/usr/share/sing-along/skills/sing-along/SKILL.md": "../skills/sing-along/SKILL.md"
        },
        "depends": []
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/sing-along.metainfo.xml": "../packaging/linux/sing-along.metainfo.xml",
          "/usr/share/man/man1/sing-along.1": "../packaging/linux/sing-along.1",
          "/usr/share/sing-along/skills/sing-along/SKILL.md": "../skills/sing-along/SKILL.md"
        },
        "bundleMediaFramework": false
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/sing-along.desktop",
        "files": {
          "/usr/share/metainfo/sing-along.metainfo.xml": "../packaging/linux/sing-along.metainfo.xml",
          "/usr/share/man/man1/sing-along.1": "../packaging/linux/sing-along.1",
          "/usr/share/sing-along/skills/sing-along/SKILL.md": "../skills/sing-along/SKILL.md"
        },
        "depends": []
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": [],
    "shortDescription": "Lyric sync for your offline music library: fetch, edit, convert and export.",
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "dmg"
    ]
  },
  "productName": "Sing-Along",
  "mainBinaryName": "sing-along",
  "identifier": "com.freelamp.SingAlong",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 768,
        "width": 1024,
        "height": 768,
        "resizable": true,
        "title": "Sing-Along Player: Offline music lyric download/edit/export",
        "decorations": true,
        "transparent": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$APPDATA/covers/**",
          "/home/**/covers/**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost http://localhost https://localhost; media-src *; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost https://asset.localhost *; style-src 'unsafe-inline' 'self'"
    }
  },
  "version": "2.10.0"
}
